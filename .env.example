DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Add the actual HTTPS origin and host when testing from Meta Quest 2.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# Enable only behind a trusted proxy that strips client X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false

# Optional upload limits (bytes / pixels). Originals are retained.
COVER_MAX_BYTES=12582912
COVER_MIN_WIDTH=320
COVER_MIN_HEIGHT=180
PANORAMA_MAX_BYTES=20971520
PANORAMA_MIN_WIDTH=1024
PANORAMA_MIN_HEIGHT=512
IMAGE_MAX_DIMENSION=8192
IMAGE_MAX_PIXELS=33554432
# Relative deviation from 2:1. 0.01 = 1% (ratio 1.98–2.02).
PANORAMA_RATIO_TOLERANCE=0.01
